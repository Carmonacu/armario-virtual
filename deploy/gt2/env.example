# Entorno del Realme GT 2 (proot Ubuntu). Copia a un fichero fuera del repo,
# por ejemplo ~/armario.env, y no lo subas a git.
# Genera SECRET_KEY con: openssl rand -hex 32

DEBUG=false
SECRET_KEY=
APP_URL=https://TU-APP.vercel.app
LOG_LEVEL=INFO

# Postgres de Supabase, esquema dedicado armario. Usa el pooler de sesión
# (aws-0-eu-west-1) y el rol armario_app. La contraseña no va en el repo.
# DATABASE_URL=postgresql+asyncpg://armario_app:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_SCHEMA=armario

REDIS_URL=redis://127.0.0.1:6379/0

# Auth de producción. El secreto JWT solo hace falta si el proyecto aún firma en HS256.
SUPABASE_URL=https://jvuzcuntgfmcjrrbsmda.supabase.co
# SUPABASE_JWT_SECRET=

# Origen del frontend en Vercel (y localhost para pruebas). Lista separada por comas.
CORS_ORIGINS=https://TU-APP.vercel.app,http://localhost:3000

# Un proxy (Tailscale Funnel) añade X-Forwarded-For.
TRUSTED_PROXY_COUNT=1

# De día el API no llama al modelo: la IA de texto solo corre en la ventana nocturna.
# El script nightly.sh fuerza AI_TEXT_ENABLED=true en su propio proceso.
AI_INTERNAL_ENABLED=true
AI_TEXT_ENABLED=false
AI_VISION_ENABLED=false
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_API_KEY=not-needed
AI_TEXT_MODEL=local
AI_TIMEOUT=180

# Imágenes en el almacenamiento del teléfono. El image-worker (rembg) no se arranca.
STORAGE_PATH=/var/lib/armario
MAX_UPLOAD_SIZE_MB=20
