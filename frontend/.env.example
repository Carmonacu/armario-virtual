# Frontend environment for local Next.js and for Vercel.
# Copy to frontend/.env.local for local dev. On Vercel, set the same names
# in Project → Settings → Environment Variables. Never commit real keys.

# Supabase Auth (same project as the other apps). The anon/publishable key is public.
NEXT_PUBLIC_SUPABASE_URL=https://jvuzcuntgfmcjrrbsmda.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Comma-separated providers already enabled on that Supabase project.
# NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=google,github

# Where the browser calls the API. Leave empty to use the same-origin /api/v1 proxy.
# On Vercel set this to the Tailscale Funnel origin (no path, no trailing slash).
# NEXT_PUBLIC_API_URL=https://PHONE.TAILNET.ts.net

# Server-side proxy target used by app/api/v1/[...path] when the browser stays on
# the Vercel origin. Set this to the same Funnel URL.
BACKEND_URL=http://127.0.0.1:8000

# Local only. Ignored when NODE_ENV=production, so Vercel never offers dev login.
# DEV_MODE=true
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=change-me-in-production-use-openssl-rand-hex-32
